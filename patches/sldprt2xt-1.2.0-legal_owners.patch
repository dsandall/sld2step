 MULTI_BODY_LEGAL_OWNERS = (1,) + (0,) * 16
 
 
+
+def _fit_legal_owners(template, owners) -> list:
+    """Size a legal_owners flag list to the template's own element count.
+
+    ATTRIB_DEF.legal_owners is a fixed-length list whose length is set by
+    the file's schema (16 in some SolidWorks 2025 partitions, 17 in the
+    exports the constants were read from). The flag positions used here
+    are all below 16, so truncating or zero-padding is exact.
+    """
+    have = template.values.get("legal_owners")
+    n = len(have) if isinstance(have, list) else len(owners)
+    out = list(owners)[:n]
+    return out + [0] * (n - len(out))
+
